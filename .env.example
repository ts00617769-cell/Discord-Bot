# ==========================================
# 🤖 波拉西亞戰記 Discord Bot 環境變數設定檔範例
# ==========================================

# 1. Discord 機器人金鑰 (必填)
# 請至 Discord Developer Portal 申請並將你的 Token 貼在下方
DISCORD_TOKEN=your_discord_bot_token_here

# 2. 戰情室頻道 ID (機密指令必填)
# 機密指令只能在這些頻道中執行，多個請用逗號分隔
# 若留空：機密指令全部拒絕（fail-closed），開機時會記錄錯誤
# 例：ALLOWED_COMMAND_CHANNELS=123456789012345678,987654321098765432
ALLOWED_COMMAND_CHANNELS=

# 3. 經驗值超速警報頻道 ID (必填)
# 當玩家時速超過設定門檻時，機器人會在此頻道發送警報
EXP_ALERT_CHANNEL_ID=

# 3.1 轉移/旅團變動警報頻道 ID (選填)
# 當玩家發生跨服轉移或改名時，機器人會在此頻道發送警報
# 若未填寫則預設不會發送轉移警報
TRANSFER_ALERT_CHANNEL_ID=

# 4. 時空縫隙首領提醒頻道 ID (必填)
# 機器人會在首領召喚前 10 分鐘發送 @everyone 提醒
BOSS_REMINDER_CHANNEL_ID=

# 5. 每日心理測驗發布頻道 ID (必填)
# 每日測驗題目會在此頻道發布
QUIZ_CHANNEL_ID=

# 6. 戰情室日誌頻道 ID (選填)
# 記錄所有機密指令執行的日誌
WAR_ROOM_CHANNEL_ID=

# 7. 每日測驗發布時間 (選填，預設 12:00)
# 格式：HH:MM (24小時制)
QUIZ_POST_TIME=12:00

# 8. 每日測驗開獎時間 (選填，預設 18:00)
# 格式：HH:MM (24小時制)
QUIZ_REVEAL_TIME=18:00

# 9. 經驗值超速警報門檻 (選填，預設 400000000000 = 時速 4000 億)
# 單位：每小時經驗值。達標後再取前 N 名發送（見 !警報 開 [數量]）
EXP_ALERT_THRESHOLD=400000000000

# 9.1 完整快照最少伺服器數 (選填，預設 = SERVER_MAP 全服數)
# 本輪「品質達標」的伺服器數未達此門檻時，會跳過轉服偵測以避免假警報
# SNAPSHOT_MIN_SERVERS=6

# 9.2 單一伺服器算入完整快照的最少玩家數 (選填，預設 30)
# 總榜失敗或合併人數低於此值的服仍會寫入，但不計入 SNAPSHOT_MIN_SERVERS
# SNAPSHOT_MIN_PLAYERS=30

# 10. SQLite 路徑 (選填)
# 預設為專案目錄下的 prasia_data.db；可改到 SSD 路徑以減輕 I/O 瓶頸
# DB_PATH=C:\data\prasia_data.db

# 11. Ranking API 成功回應快取秒數 (選填，預設 45)
# 設為 0 可關閉快取（測速／背景掃描較吃 API）
# RANKING_CACHE_TTL=45